rules_version = '2';

// 날아라 슈퍼카 leaderboard.
// Firebase console → Firestore Database → Rules → paste this → Publish.
// Everyone can read the board; a player (anonymous sign-in) can write only scores/<their uid>,
// a best score can only go up, and nobody can delete through the website.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{playerId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == playerId;
      }
      function validRun() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nick', 'score', 'at'])
          && d.nick is string && d.nick.size() >= 1 && d.nick.size() <= 10
          && d.score is int && d.score >= 0 && d.score <= 100000;   // 10 points per second
      }

      allow read: if true;
      allow create: if isOwner() && validRun();
      allow update: if isOwner() && validRun() && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }
  }
}
